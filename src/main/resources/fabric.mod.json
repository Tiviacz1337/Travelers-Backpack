{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "accessWidener" : "travelersbackpack.accesswidener",
  "name": "${mod_display_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_display_url}",
    "issues": "${mod_issue_tracker_url}"
  },
  "license": "${mod_license}",
  "icon": "assets/${mod_id}/textures/logo.png",
  "environment": "*",
  "custom": {
    "cardinal-components": [
      "travelersbackpack:travelersbackpack"
    ]
  },
  "entrypoints": {
    "fabric-datagen": [
      "com.tiviacz.travelersbackpack.datagen.ModDataGeneration"
    ],
    "main": [
      "com.tiviacz.travelersbackpack.TravelersBackpack"
    ],
    "client": [
      "com.tiviacz.travelersbackpack.TravelersBackpackClient"
    ],
    "emi": [
      "com.tiviacz.travelersbackpack.compat.emi.EmiCompat"
    ],
    "rei_client": [
      "com.tiviacz.travelersbackpack.compat.rei.ReiClientCompat"
    ],
    "jei_mod_plugin": [
      "com.tiviacz.travelersbackpack.compat.jei.TravelersBackpackPlugin"
    ],
    "cardinal-components-entity": [
      "com.tiviacz.travelersbackpack.component.ComponentUtils"
    ],
    "modmenu": [
      "com.tiviacz.travelersbackpack.compat.modmenu.ModMenuIntegration"
    ],
    "lambdynlights:initializer": [
      "com.tiviacz.travelersbackpack.compat.lambdynamiclight.BackpackDynamicLight"
    ]
  },
  "mixins": [
    "travelersbackpack.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.11",
    "fabric": ">=0.115.1",
    "minecraft": "${minecraft_version_range}",
    "java": ">=21",
    "cardinal-components-base": "*",
    "cardinal-components-entity": "*",
    "cloth-config2": "*"
  },
  "breaks": {
    "accessories": "<1.1.0-beta.3+1.21.1",
    "yigd": "<2.4.13"
  }
}